.detail-page { min-height: 100vh; padding-bottom: 136rpx; background: var(--bg); }.detail-topbar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; background: #fff; border-bottom: 1rpx solid var(--line); }.detail-topbar-title { color: var(--ink); font-size: 32rpx; font-weight: 750; }.detail-swiper { height: 560rpx; background: var(--ink); }.detail-image { width: 100%; min-height: 560rpx; max-height: 560rpx; background: var(--brand-soft); }.detail-empty-image { display: flex; align-items: center; justify-content: center; height: 300rpx; color: var(--muted); background: var(--brand-soft); font-size: 26rpx; }.detail-content { padding: 30rpx 28rpx; background: #fff; }.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }.detail-name { min-width: 0; flex: 1; color: var(--ink); font-size: 38rpx; font-weight: 750; line-height: 1.28; }.detail-price { flex: none; color: var(--accent); font-size: 35rpx; font-weight: 800; }.detail-stock { margin-top: 12rpx; color: var(--muted); font-size: 23rpx; }.detail-section { margin-top: 34rpx; padding-top: 26rpx; border-top: 1rpx solid var(--line); }.detail-section-title { color: var(--ink); font-size: 28rpx; font-weight: 750; }.detail-description { margin-top: 14rpx; color: #466259; font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; }.detail-action-bar { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 16rpx; height: 116rpx; padding: 0 28rpx; box-sizing: border-box; border-top: 1rpx solid var(--line); background: #fff; }.detail-cart { display: flex; align-items: center; min-width: 0; flex: 1; gap: 12rpx; color: var(--ink); font-size: 26rpx; }.detail-cart-count { min-width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: 22rpx; font-weight: 750; line-height: 44rpx; text-align: center; }.detail-stepper { display: flex; align-items: center; flex: 0 0 auto; gap: 12rpx; }.detail-step { width: 52rpx; height: 52rpx; min-width: 52rpx; flex: 0 0 52rpx; box-sizing: border-box; border-radius: 10rpx; color: var(--brand); background: var(--brand-soft); font-size: 34rpx; font-weight: 600; line-height: 52rpx; text-align: center; }.detail-step.plus { color: #fff; background: var(--brand); }.detail-quantity-input { width: 44rpx; min-width: 44rpx; height: 52rpx; padding: 0; box-sizing: border-box; color: var(--ink); font-size: 26rpx; font-weight: 700; line-height: 52rpx; text-align: center; }.empty-link { color: var(--brand); font-weight: 700; }
