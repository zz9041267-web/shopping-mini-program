.menu-page { height: 100vh; box-sizing: border-box; padding-bottom: 210rpx; background: var(--surface); }.store-hero { position: relative; height: 258rpx; overflow: hidden; background: var(--brand-deep); }.store-cover,.store-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }.store-overlay { background: linear-gradient(90deg, rgba(8, 44, 34, .87), rgba(8, 44, 34, .35)); }.store-content { position: relative; z-index: 1; height: 100%; padding: 38rpx 28rpx 30rpx; box-sizing: border-box; color: #fff; }.store-top { display: flex; align-items: center; }.store-badge { width: 76rpx; height: 76rpx; line-height: 76rpx; border-radius: 16rpx; text-align: center; font-size: 27rpx; font-weight: 800; color: var(--brand-deep); background: #fff6e8; }.store-title-wrap { flex: 1; min-width: 0; margin-left: 18rpx; }.store-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 36rpx; font-weight: 750; color: var(--ink); }.store-meta { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 23rpx; }.store-language { color: #fff; }.store-note { margin-top: 30rpx; max-width: 600rpx; font-size: 24rpx; line-height: 1.45; color: rgba(255,255,255,.92); }.menu-shell { display: flex; height: calc(100vh - 468rpx); overflow: hidden; }.category-rail { width: 176rpx; min-width: 176rpx; max-width: 176rpx; height: 100%; box-sizing: border-box; flex: 0 0 176rpx; background: #f5f7f4; }.category-item { width: 176rpx; min-height: 98rpx; box-sizing: border-box; padding: 24rpx 14rpx; color: var(--muted); text-align: center; font-size: 25rpx; line-height: 1.35; word-break: break-word; }.category-current { position: relative; color: var(--brand-deep); font-weight: 700; background: #fff; }.category-current::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 6rpx; border-radius: 0 4rpx 4rpx 0; background: var(--brand); content: ''; }.product-feed { min-width: 0; height: 100%; flex: 1 1 0; background: #fff; }.product-card { display: flex; min-height: 196rpx; padding: 24rpx 22rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--line); }.product-image,.image-fallback { width: 148rpx; height: 148rpx; flex: none; border-radius: 12rpx; background: #deebe4; }.image-fallback { display: flex; align-items: center; justify-content: center; color: var(--brand-deep); font-size: 44rpx; font-weight: 700; }.product-copy { min-width: 0; flex: 1; margin-left: 20rpx; }.product-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 750; color: var(--ink); }.product-description { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: var(--muted); font-size: 23rpx; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.product-foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 10rpx; }.product-price { color: var(--accent); font-size: 32rpx; font-weight: 800; }.product-stock { margin-top: 4rpx; color: #8a9892; font-size: 20rpx; }.quantity-control { display: flex; align-items: center; gap: 12rpx; }.quantity-btn { width: 48rpx; height: 48rpx; min-width: 48rpx; padding: 0; line-height: 46rpx; border-radius: 10rpx; font-size: 30rpx; font-weight: 600; }.plus { color: #fff; background: var(--brand); }.minus { color: var(--brand); background: var(--brand-soft); }.quantity { min-width: 22rpx; text-align: center; font-size: 24rpx; }.checkout-bar { position: fixed; z-index: 5; right: 24rpx; bottom: 122rpx; left: 24rpx; display: flex; align-items: center; height: 100rpx; padding: 0 12rpx 0 18rpx; box-sizing: border-box; border-radius: 18rpx; background: var(--ink); color: #fff; box-shadow: 0 10rpx 26rpx rgba(15, 48, 40, .2); }.checkout-summary { display: flex; align-items: center; flex: 1; }.cart-count { min-width: 54rpx; height: 54rpx; margin-right: 14rpx; border-radius: 50%; background: var(--brand); color: #fff; font-size: 24rpx; font-weight: 700; line-height: 54rpx; text-align: center; }.checkout-total { font-size: 32rpx; font-weight: 800; }.checkout-caption { margin-top: 2rpx; color: rgba(255,255,255,.68); font-size: 20rpx; }.checkout-action { padding: 18rpx 25rpx; border-radius: 12rpx; background: var(--accent); font-size: 26rpx; font-weight: 700; }.menu-nav { position: fixed; z-index: 4; bottom: 0; left: 0; display: flex; width: 100%; height: 110rpx; box-sizing: border-box; padding-top: 14rpx; border-top: 1rpx solid var(--line); background: #fff; }.menu-nav-item { flex: 1; color: var(--muted); font-size: 24rpx; line-height: 72rpx; text-align: center; }.menu-nav-item.active { color: var(--brand); font-weight: 750; }.retry { color: var(--brand); font-weight: 700; }.store-name { color: #fff; }
.quantity-control { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; min-width: 52rpx; flex: 0 0 auto; }.quantity-btn { display: none; }.quantity-step { width: 52rpx; height: 52rpx; min-width: 52rpx; flex: 0 0 52rpx; box-sizing: border-box; border-radius: 10rpx; font-size: 34rpx; font-weight: 600; line-height: 52rpx; text-align: center; }.quantity-step.plus { color: #fff; background: var(--brand); }.quantity-step.minus { color: var(--brand); background: var(--brand-soft); }.quantity-input { width: 34rpx; min-width: 34rpx; height: 52rpx; padding: 0; color: var(--ink); font-size: 25rpx; font-weight: 700; line-height: 52rpx; text-align: center; }
.spec-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(10, 35, 28, .45); }.spec-panel { width: 100%; max-height: 78vh; padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 20rpx 20rpx 0 0; background: #fff; }.spec-title { overflow: hidden; color: var(--ink); font-size: 32rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }.spec-label { margin-top: 24rpx; color: var(--muted); font-size: 23rpx; }.spec-options { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }.spec-chip { display: flex; align-items: center; gap: 8rpx; min-height: 56rpx; padding: 0 16rpx; border: 1rpx solid #cad8d1; border-radius: 8rpx; color: var(--ink); font-size: 24rpx; }.spec-chip text { margin-left: 4rpx; color: var(--muted); font-size: 20rpx; }.spec-chip.selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }.color-dot { width: 20rpx; height: 20rpx; border: 1rpx solid rgba(0,0,0,.12); border-radius: 50%; }.spec-quantity { width: 140rpx; height: 66rpx; margin-top: 12rpx; padding: 0 14rpx; box-sizing: border-box; border: 1rpx solid #cad8d1; border-radius: 8rpx; color: var(--ink); font-size: 28rpx; line-height: 66rpx; text-align: center; }.spec-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }.spec-cancel,.spec-confirm { flex: 1; height: 80rpx; border-radius: 10rpx; font-size: 27rpx; font-weight: 700; line-height: 80rpx; text-align: center; }.spec-cancel { color: var(--ink); background: #f0f4f1; }.spec-confirm { color: #fff; background: var(--brand); }
