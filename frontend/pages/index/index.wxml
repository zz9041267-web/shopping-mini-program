<view class="menu-page"><view class="store-hero"><image wx:if="{{shop.coverImageBase64}}" class="store-cover" src="{{shop.coverImageBase64}}" mode="aspectFill"></image><view class="store-overlay"></view><view class="store-content"><view class="store-top"><view class="store-badge">KB</view><view class="store-title-wrap"><view class="store-name">{{shop.displayName || t.shop}}</view><view class="store-meta">{{t.delivery}}</view></view><view class="language-toggle store-language" bindtap="toggleLanguage">{{t.language}}</view></view><view class="store-note">{{shop.displayNotice}}</view></view></view><view class="menu-shell"><scroll-view class="category-rail" scroll-y><view wx:for="{{categories}}" wx:key="id" class="category-item {{activeCategory === item.id ? 'category-current' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.displayName}}</view></scroll-view><scroll-view class="product-feed" scroll-y><view wx:if="{{loading}}" class="empty">{{t.loadingMenu}}</view><view wx:elif="{{loadFailed}}" class="empty">Unable to load menu<br/><text class="retry" bindtap="load">Retry</text></view><view wx:for="{{activeProducts}}" wx:key="id" class="product-card"><image wx:if="{{item.displayImage}}" class="product-image product-detail-link" src="{{item.displayImage}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openProduct"></image><view wx:else class="image-fallback product-detail-link" data-id="{{item.id}}" bindtap="openProduct">{{item.initial}}</view><view class="product-copy"><view class="product-name product-detail-link" data-id="{{item.id}}" bindtap="openProduct">{{item.displayName}}</view><view class="product-description product-detail-link" data-id="{{item.id}}" bindtap="openProduct">{{item.displayDescription}}</view><view class="product-foot"><view><view class="product-price">¥{{item.price}}</view><view class="product-stock">{{t.stock}} {{item.stock}}</view></view><view class="quantity-step plus" data-id="{{item.id}}" catchtap="openSelector">+</view></view></view></view></scroll-view></view><view class="checkout-bar" bindtap="toCart"><view class="checkout-summary"><view class="cart-count">{{cartCount}}</view><view><view class="checkout-total">¥{{cartTotal}}</view><view class="checkout-caption">{{cartCount ? t.selected : t.chooseProducts}}</view></view></view><view class="checkout-action">{{t.checkout}}</view></view><view class="menu-nav"><view class="menu-nav-item active">{{t.menu}}</view><view class="menu-nav-item" bindtap="toCart">{{t.cart}}</view><navigator class="menu-nav-item" url="/pages/orders/orders">{{t.orders}}</navigator></view><view wx:if="{{selectorVisible}}" class="spec-mask" catchtap="closeSelector"><view class="spec-panel" catchtap=""><view class="spec-title">{{selection.product.displayName}}</view><view class="spec-label">{{t.size}}</view><view class="spec-options"><view wx:for="{{selection.product.sizeSet.options}}" wx:key="code" class="spec-chip {{selection.sizeIndex===index?'selected':''}}" data-index="{{index}}" bindtap="chooseSize">{{item.code}}<text>{{item.lengthValue}} × {{item.widthValue}}</text></view></view><view class="spec-label">{{t.color}}</view><view class="spec-options"><view wx:for="{{selection.product.colorSet.options}}" wx:key="code" class="spec-chip {{selection.colorIndex===index?'selected':''}}" data-index="{{index}}" bindtap="chooseColor"><view class="color-dot" style="background:{{item.hexValue}}"></view>{{item.displayName}}</view></view><view class="spec-label">{{t.quantity}}</view><input class="spec-quantity" type="number" value="{{selection.quantity}}" bindinput="selectionQuantity"/><view class="spec-actions"><view class="spec-cancel" bindtap="closeSelector">{{t.cancel}}</view><view class="spec-confirm" bindtap="confirmSelector">{{t.addToList}}</view></view></view></view></view>
