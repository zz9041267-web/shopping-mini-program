<view class="admin-page">
  <view class="admin-header"><view><view class="admin-kicker">{{t.admin}}</view><view class="admin-title">{{shopDisplayName || t.workspace}}</view></view><view class="header-actions"><view class="language-toggle header-language" bindtap="toggleLanguage">{{t.language}}</view><view class="logout-link" bindtap="logout">{{t.logout}}</view></view></view>
  <scroll-view class="admin-tabs" scroll-x enable-flex><view class="admin-tab {{tab==='shop'?'selected':''}}" data-tab="shop" bindtap="tab">{{t.shopSettings}}</view><view class="admin-tab {{tab==='products'?'selected':''}}" data-tab="products" bindtap="tab">{{t.products}}</view><view class="admin-tab {{tab==='categories'?'selected':''}}" data-tab="categories" bindtap="tab">{{t.categories}}</view><view class="admin-tab {{tab==='specs'?'selected':''}}" data-tab="specs" bindtap="tab">{{t.specifications}}</view><view class="admin-tab {{tab==='orders'?'selected':''}}" data-tab="orders" bindtap="tab">{{t.adminOrders}}</view></scroll-view>
  <view wx:if="{{loading}}" class="empty">{{t.loadingMenu}}</view>
  <view wx:elif="{{tab==='shop'}}" class="admin-content"><view class="section-intro"><view class="section-title">{{t.shopSettings}}</view><text>{{t.shopHint}}</text></view><view class="form-sheet"><view class="form-label">{{t.bilingual}}</view><input class="field" placeholder="{{t.nameZh}}" data-key="nameZh" value="{{shopForm.nameZh}}" bindinput="shopField"/><input class="field" placeholder="{{t.nameEn}}" data-key="nameEn" value="{{shopForm.nameEn}}" bindinput="shopField"/><input class="field" placeholder="{{t.noticeZh}}" data-key="noticeZh" value="{{shopForm.noticeZh}}" bindinput="shopField"/><input class="field" placeholder="{{t.noticeEn}}" data-key="noticeEn" value="{{shopForm.noticeEn}}" bindinput="shopField"/><view class="media-section"><view><view class="media-title">{{t.shopCover}}</view><button class="secondary-btn compact-button" data-key="coverImageBase64" bindtap="chooseShopImage">{{t.selectImage}}</button></view><image wx:if="{{shopForm.coverImageBase64}}" class="cover-preview" src="{{shopForm.coverImageBase64}}" mode="aspectFill"></image></view><view class="media-section"><view><view class="media-title">{{t.wechatQr}}</view><button class="secondary-btn compact-button" data-key="wechatQrBase64" bindtap="chooseShopImage">{{t.selectImage}}</button></view><image wx:if="{{shopForm.wechatQrBase64}}" class="qr-preview" src="{{shopForm.wechatQrBase64}}" mode="aspectFit"></image></view><button class="primary-btn" bindtap="saveShop">{{t.saveShop}}</button></view></view>
  <view wx:elif="{{tab==='products'}}" class="admin-content"><view class="section-intro"><view class="section-title">{{editingProductId ? t.update : t.addProduct}}</view><text>{{t.productHint}}</text></view><view class="form-sheet"><view class="form-label">{{t.bilingual}}</view><input class="field" placeholder="{{t.nameZh}}" data-key="nameZh" value="{{form.nameZh}}" bindinput="field"/><input class="field" placeholder="{{t.nameEn}}" data-key="nameEn" value="{{form.nameEn}}" bindinput="field"/><textarea class="field textarea" placeholder="{{t.descriptionZh}}" data-key="descriptionZh" value="{{form.descriptionZh}}" bindinput="field"/><textarea class="field textarea" placeholder="{{t.descriptionEn}}" data-key="descriptionEn" value="{{form.descriptionEn}}" bindinput="field"/><view class="field-row"><input class="field" placeholder="{{t.price}}" type="digit" data-key="price" value="{{form.price}}" bindinput="field"/><input class="field" placeholder="{{t.inventory}}" type="number" data-key="stock" value="{{form.stock}}" bindinput="field"/></view><picker wx:if="{{categories.length}}" range="{{categories}}" range-key="displayName" value="{{categoryIndex}}" bindchange="category"><view class="picker-field">{{t.category}}: {{categories[categoryIndex].displayName}}</view></picker><view wx:else class="picker-field">{{t.selectCategory}}</view><view class="image-upload-block"><view class="media-title">{{t.displayImages}}</view><view class="media-note">{{t.displayImagesHint}}</view><view class="image-grid"><view wx:for="{{form.displayImagesBase64}}" wx:key="*this" class="image-thumb"><image src="{{item}}" mode="aspectFill"></image><view class="image-remove" data-key="displayImagesBase64" data-index="{{index}}" bindtap="removeProductImage">x</view></view><button wx:if="{{form.displayImagesBase64.length != 5}}" class="image-add" data-key="displayImagesBase64" bindtap="chooseProductImages">+</button></view></view><view class="image-upload-block"><view class="media-title">{{t.detailImages}}</view><view class="media-note">{{t.detailImagesHint}}</view><view class="image-grid"><view wx:for="{{form.detailImagesBase64}}" wx:key="*this" class="image-thumb"><image src="{{item}}" mode="aspectFill"></image><view class="image-remove" data-key="detailImagesBase64" data-index="{{index}}" bindtap="removeProductImage">x</view></view><button wx:if="{{form.detailImagesBase64.length != 5}}" class="image-add" data-key="detailImagesBase64" bindtap="chooseProductImages">+</button></view></view><view class="form-actions"><button wx:if="{{editingProductId}}" class="secondary-btn cancel-button" bindtap="cancelProductEdit">{{t.cancel}}</button><button class="primary-btn form-save" bindtap="addProduct">{{editingProductId ? t.update : t.addProduct}}</button></view></view><view class="list-heading">{{t.allProducts}} <text>{{products.length}}</text></view><view wx:for="{{products}}" wx:key="id" class="admin-product"><image wx:if="{{item.displayImagesBase64.length || item.imageBase64}}" class="admin-product-image" src="{{item.displayImagesBase64[0] || item.imageBase64}}" mode="aspectFill"></image><view wx:else class="admin-image-fallback">{{item.initial}}</view><view class="admin-product-copy"><view class="admin-product-name">{{item.displayName}}</view><view class="admin-product-meta">CNY {{item.price}} · {{t.stock}} {{item.stock}}</view><view class="sale-state {{item.onSale?'on':''}}">{{item.onSale ? t.putOn : t.takeOff}}</view></view><view class="admin-product-actions"><button class="edit-button" data-product="{{item}}" bindtap="editProduct">{{t.edit}}</button><button class="sale-button" data-product="{{item}}" bindtap="toggleSale">{{item.onSale ? t.takeOff : t.putOn}}</button></view></view></view>
  <view wx:elif="{{tab==='categories'}}" class="admin-content"><view class="section-intro"><view class="section-title">{{editingCategoryId ? t.update : t.addCategory}}</view><text>{{t.categoryHint}}</text></view><view class="form-sheet"><input class="field" placeholder="{{t.nameZh}}" data-key="nameZh" value="{{categoryForm.nameZh}}" bindinput="categoryField"/><input class="field" placeholder="{{t.nameEn}}" data-key="nameEn" value="{{categoryForm.nameEn}}" bindinput="categoryField"/><view class="form-actions"><button wx:if="{{editingCategoryId}}" class="secondary-btn cancel-button" bindtap="cancelCategoryEdit">{{t.cancel}}</button><button class="primary-btn form-save" bindtap="addCategory">{{editingCategoryId ? t.update : t.addCategory}}</button></view></view><view wx:for="{{categories}}" wx:key="id" class="category-record"><view class="category-order">{{index + 1}}</view><view class="category-copy"><view class="category-title">{{item.nameZh}}</view><view class="category-subtitle">{{item.nameEn}}</view></view><button class="edit-button" data-category="{{item}}" bindtap="editCategory">{{t.edit}}</button></view></view>
  <view wx:elif="{{tab==='orders'}}" class="admin-content"><view class="order-search"><input class="order-search-input" placeholder="{{t.orderSearch}}" value="{{orderSearch}}" confirm-type="search" bindinput="orderSearchField" bindconfirm="searchOrders"/><button class="secondary-btn order-search-button" bindtap="searchOrders">{{t.search}}</button><view wx:if="{{orderSearch}}" class="order-search-clear" bindtap="clearOrderSearch">x</view></view><view wx:if="{{!orders.length}}" class="empty">{{t.noOrders}}</view><view wx:for="{{orders}}" wx:key="id" class="order-record"><view class="order-record-head"><view><view class="order-id">{{item.orderNo}}</view><view class="order-customer">{{t.customer}}: {{item.customerName}}</view></view><view class="order-status">{{item.statusText}}</view></view><view wx:if="{{item.recipientName}}" class="order-shipping"><view>{{t.recipientName}}: {{item.recipientName}} {{item.contactPhone}}</view><view>{{t.shippingAddress}}: {{item.shippingAddress}}</view></view><view wx:for="{{item.items}}" wx:for-item="product" wx:key="id" class="order-line"><text>{{product.displayName}} x{{product.quantity}}</text><text>CNY {{product.unitPrice}}</text></view><view class="order-record-foot"><text>CNY {{item.totalAmount}}</text><button wx:if="{{item.status==='CREATED'||item.status==='ACCEPTED'}}" class="secondary-btn order-action" data-order="{{item}}" bindtap="nextStatus">{{item.status==='CREATED'?t.receive:t.finish}}</button></view></view></view>
  <view wx:if="{{tab==='specs'}}" class="admin-content"><view class="section-intro"><view class="section-title">{{t.specifications}}</view></view><view class="form-sheet"><view class="form-label">{{t.sizeSets}}</view><input class="field" placeholder="{{t.sizeSetName}}" data-key="nameZh" value="{{sizeSetForm.nameZh}}" bindinput="sizeSetNameField"/><input class="field" placeholder="{{t.sizeSetNameEn}}" data-key="nameEn" value="{{sizeSetForm.nameEn}}" bindinput="sizeSetNameField"/><view wx:for="{{sizeSetForm.options}}" wx:key="index" class="spec-option-row"><input class="spec-field" placeholder="{{t.sizeCode}}" data-index="{{index}}" data-key="code" value="{{item.code}}" bindinput="sizeSetField"/><input class="spec-field" placeholder="{{t.garmentLength}}" type="number" data-index="{{index}}" data-key="lengthValue" value="{{item.lengthValue}}" bindinput="sizeSetField"/><input class="spec-field" placeholder="{{t.garmentWidth}}" type="number" data-index="{{index}}" data-key="widthValue" value="{{item.widthValue}}" bindinput="sizeSetField"/></view><button class="secondary-btn" bindtap="addSizeOption">{{t.addSize}}</button><button class="primary-btn spec-save" bindtap="saveSizeSet">{{t.saveSizeSet}}</button></view><view class="form-sheet spec-form"><view class="form-label">{{t.colorSets}}</view><input class="field" placeholder="{{t.colorSetName}}" data-key="nameZh" value="{{colorSetForm.nameZh}}" bindinput="colorSetNameField"/><input class="field" placeholder="{{t.colorSetNameEn}}" data-key="nameEn" value="{{colorSetForm.nameEn}}" bindinput="colorSetNameField"/><view wx:for="{{colorSetForm.options}}" wx:key="index" class="color-option-row"><input class="spec-field" placeholder="{{t.colorCode}}" data-index="{{index}}" data-key="code" value="{{item.code}}" bindinput="colorSetField"/><input class="spec-field" placeholder="{{t.colorNameZh}}" data-index="{{index}}" data-key="nameZh" value="{{item.nameZh}}" bindinput="colorSetField"/><input class="spec-field" placeholder="{{t.colorNameEn}}" data-index="{{index}}" data-key="nameEn" value="{{item.nameEn}}" bindinput="colorSetField"/><input class="spec-field" placeholder="{{t.colorHex}}" data-index="{{index}}" data-key="hexValue" value="{{item.hexValue}}" bindinput="colorSetField"/></view><button class="secondary-btn" bindtap="addColorOption">{{t.addColor}}</button><button class="primary-btn spec-save" bindtap="saveColorSet">{{t.saveColorSet}}</button></view></view>
</view>
