.admin-page { min-height: 100vh; background: var(--bg); }.admin-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 40rpx 28rpx 30rpx; background: var(--ink); color: #fff; }.admin-kicker { color: #a7c8bc; font-size: 22rpx; letter-spacing: 1rpx; }.admin-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 750; }.header-actions { display: flex; gap: 12rpx; align-items: center; }.header-language { color: #fff; }.logout-link { padding: 12rpx 2rpx; color: #c6d7d1; font-size: 24rpx; }.admin-tabs { display: flex; height: 88rpx; white-space: nowrap; background: #fff; border-bottom: 1rpx solid var(--line); }.admin-tab { display: inline-block; min-width: 152rpx; height: 88rpx; box-sizing: border-box; color: var(--muted); font-size: 26rpx; line-height: 88rpx; text-align: center; }.admin-tab.selected { color: var(--brand); font-weight: 750; border-bottom: 5rpx solid var(--brand); }.admin-content { padding: 28rpx 24rpx 54rpx; }.section-intro { margin: 8rpx 0 20rpx; }.section-title { font-size: 35rpx; font-weight: 750; color: var(--ink); }.section-intro text { display: block; margin-top: 9rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }.form-sheet { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; }.form-label { margin-bottom: 16rpx; color: var(--brand); font-size: 23rpx; font-weight: 700; }.field,.picker-field { width: 100%; height: 82rpx; margin-bottom: 16rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #d6e1db; border-radius: 12rpx; background: #fbfcfb; color: var(--ink); font-size: 27rpx; line-height: 80rpx; }.textarea { height: 126rpx; padding-top: 17rpx; line-height: 1.45; }.field-row { display: flex; gap: 16rpx; }.field-row .field { min-width: 0; flex: 1; }.spec-option-row,.color-option-row { display: flex; gap: 10rpx; margin-bottom: 12rpx; }.spec-field { min-width: 0; flex: 1; height: 70rpx; padding: 0 12rpx; box-sizing: border-box; border: 1rpx solid #d6e1db; border-radius: 8rpx; background: #fbfcfb; font-size: 22rpx; }.spec-form { margin-top: 20rpx; }.spec-save { margin-top: 16rpx; }
