<view class="cart-page"><view class="cart-header"><view><view class="cart-title">{{t.cart}}</view><view class="cart-subtitle">{{t.selected}}</view></view><view class="language-toggle cart-language" bindtap="toggleLanguage">{{t.language}}</view></view><view class="address-section"><view class="address-section-head"><view class="address-section-title">{{t.selectAddress}}</view><view class="address-manage" bindtap="manageAddresses">{{t.manageAddresses}}</view></view><picker wx:if="{{addresses.length}}" range="{{addresses}}" range-key="displayAddress" value="{{selectedAddressIndex}}" bindchange="chooseAddress"><view class="address-picker"><view class="address-picker-name">{{addresses[selectedAddressIndex].recipientName}} {{addresses[selectedAddressIndex].contactPhone}}</view><view class="address-picker-detail">{{addresses[selectedAddressIndex].shippingAddress}}</view></view></picker><view wx:else class="address-empty" bindtap="manageAddresses">{{t.noAddresses}}</view></view><view wx:if="{{items.length}}" class="cart-list"><view class="cart-item" wx:for="{{items}}" wx:key="cartKey"><view class="cart-item-copy"><view class="cart-item-name">{{item.displayName}}</view><view class="cart-item-spec">{{t.size}} {{item.sizeCode}} · {{t.dimensions}} {{item.sizeLength}} × {{item.sizeWidth}} · {{t.color}} {{item.displayColor}}</view><view class="cart-item-price">¥{{item.price}}</view></view><view class="cart-stepper"><view class="cart-step" data-id="{{item.cartKey}}" data-delta="-1" bindtap="change">-</view><input class="cart-quantity-input" type="number" value="{{item.quantity}}" data-id="{{item.cartKey}}" bindblur="setQuantity"/><view class="cart-step add" data-id="{{item.cartKey}}" data-delta="1" bindtap="change">+</view></view></view></view><view wx:else class="empty">{{t.emptyCart}}<br/><navigator url="/pages/index/index" class="empty-link">{{t.goMenu}}</navigator></view><view wx:if="{{items.length}}" class="cart-submit"><view><view class="cart-total-label">{{t.total}}</view><view class="cart-total">¥{{total}}</view></view><button class="primary-btn cart-submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{t.submitOrder}}</button></view></view>
