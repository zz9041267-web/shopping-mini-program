.cart-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 24rpx 156rpx; background: var(--bg); }.cart-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28rpx; }.cart-title { font-size: 40rpx; font-weight: 750; }.cart-subtitle { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }.cart-language { color: var(--brand); }.address-section { margin-bottom: 22rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fff; }.address-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }.address-section-title { color: var(--ink); font-size: 27rpx; font-weight: 750; }.address-manage { color: var(--brand); font-size: 23rpx; }.address-picker { position: relative; padding-right: 36rpx; }.address-picker::after { position: absolute; top: 44%; right: 6rpx; width: 11rpx; height: 11rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); content: ''; transform: rotate(45deg); }.address-picker-name { color: var(--ink); font-size: 26rpx; font-weight: 700; }.address-picker-detail { overflow: hidden; margin-top: 7rpx; color: var(--muted); font-size: 23rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }.address-empty { padding: 14rpx 0; color: var(--brand); font-size: 25rpx; }.cart-list { overflow: hidden; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; }.cart-item { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid var(--line); }.cart-item:last-child { border-bottom: 0; }.cart-item-copy { min-width: 0; flex: 1; }.cart-item-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }.cart-item-price { margin-top: 8rpx; color: var(--accent); font-size: 26rpx; font-weight: 750; }.cart-stepper { display: flex; align-items: center; gap: 12rpx; flex: 0 0 auto; margin-left: 16rpx; font-size: 26rpx; }.cart-step { width: 52rpx; height: 52rpx; min-width: 52rpx; flex: 0 0 52rpx; box-sizing: border-box; border-radius: 10rpx; color: var(--brand); background: var(--brand-soft); font-size: 34rpx; font-weight: 600; line-height: 52rpx; text-align: center; }.cart-step.add { color: #fff; background: var(--brand); }.cart-quantity-input { width: 44rpx; min-width: 44rpx; height: 52rpx; padding: 0; box-sizing: border-box; color: var(--ink); font-size: 26rpx; font-weight: 700; line-height: 52rpx; text-align: center; }.cart-submit { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; height: 126rpx; padding: 0 24rpx; box-sizing: border-box; border-top: 1rpx solid var(--line); background: #fff; }.cart-total-label { color: var(--muted); font-size: 22rpx; }.cart-total { margin-top: 3rpx; color: var(--accent); font-size: 38rpx; font-weight: 800; }.cart-submit-btn { width: 250rpx; margin: 0; }
