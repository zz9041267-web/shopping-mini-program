<view class="login-page"><view class="language-toggle login-language" bindtap="toggleLanguage">{{t.language}}</view><view class="login-brand"><view class="brand-mark">KB</view><view><view class="brand-name">{{t.shop}}</view><view class="brand-copy">{{t.delivery}}</view></view></view><view class="login-panel"><view class="login-heading">{{t.loginTitle}}</view><view class="role-option {{selected==='user'?'selected':''}}" data-role="user" bindtap="choose"><view class="role-index">01</view><view><view class="role-title">{{t.userRole}}</view><view class="role-copy">{{t.userRoleDesc}}</view></view></view><view class="role-option {{selected==='admin'?'selected':''}}" data-role="admin" bindtap="choose"><view class="role-index">02</view><view><view class="role-title">{{t.adminRole}}</view><view class="role-copy">{{t.adminRoleDesc}}</view></view></view><button class="primary-btn login-button" bindtap="login">{{selected==='admin'?t.enterAdmin:t.enterShop}}</button></view></view>
