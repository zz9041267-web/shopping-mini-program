.login-page { min-height: 100vh; box-sizing: border-box; padding: 132rpx 42rpx 60rpx; background: #edf4f0; }.login-language { position: absolute; top: 30rpx; right: 30rpx; color: var(--brand); }.login-brand { display: flex; align-items: center; gap: 20rpx; margin-bottom: 76rpx; }.brand-mark { width: 82rpx; height: 82rpx; border-radius: 18rpx; background: var(--brand); color: #fff; font-size: 28rpx; font-weight: 800; line-height: 82rpx; text-align: center; }.brand-name { color: var(--ink); font-size: 40rpx; font-weight: 780; }.brand-copy { margin-top: 8rpx; color: var(--muted); font-size: 23rpx; }.login-panel { padding: 30rpx; border: 1rpx solid #dce7e1; border-radius: 20rpx; background: #fff; box-shadow: 0 18rpx 40rpx rgba(24, 68, 54, .09); }.login-heading { margin-bottom: 22rpx; font-size: 31rpx; font-weight: 750; }.role-option { display: flex; gap: 18rpx; padding: 24rpx 18rpx; margin-top: 14rpx; border: 1rpx solid var(--line); border-radius: 14rpx; }.role-option.selected { border-color: var(--brand); background: var(--brand-soft); }.role-index { width: 44rpx; color: var(--brand); font-size: 21rpx; font-weight: 800; line-height: 39rpx; }.role-title { font-size: 28rpx; font-weight: 700; }.role-copy { margin-top: 7rpx; color: var(--muted); font-size: 22rpx; line-height: 1.4; }.login-button { margin-top: 28rpx; }
