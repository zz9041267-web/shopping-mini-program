<view class="orders-page"><view class="orders-header"><view><view class="orders-title">{{t.orders}}</view><view class="orders-subtitle">{{t.order}}</view></view><view class="language-toggle orders-language" bindtap="toggleLanguage">{{t.language}}</view></view><view wx:if="{{loading}}" class="empty">{{t.loadingMenu}}</view><view wx:elif="{{!orders.length}}" class="empty">{{t.noOrders}}<br/><navigator url="/pages/index/index" class="empty-link">{{t.goMenu}}</navigator></view><view wx:for="{{orders}}" wx:key="id" class="order-card"><view class="order-card-head"><view><view class="order-number">{{item.orderNo}}</view><view class="order-date">{{item.createdAtText}}</view></view><view class="order-status">{{item.statusText}}</view></view><view wx:for="{{item.items}}" wx:for-item="food" wx:key="id" class="order-item"><text>{{food.displayName}} x{{food.quantity}}</text><text>¥{{food.unitPrice}}</text></view><view class="order-card-foot"><view>{{t.total}} <text>¥{{item.totalAmount}}</text></view><view class="wechat-link" bindtap="previewWechat">{{t.addWechat}}</view></view></view></view>
