.orders-page { min-height: 100vh; padding: 30rpx 24rpx 48rpx; box-sizing: border-box; background: var(--bg); }.orders-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28rpx; }.orders-title { font-size: 40rpx; font-weight: 750; }.orders-subtitle { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }.orders-language { color: var(--brand); }.order-card { margin-bottom: 16rpx; padding: 23rpx; border: 1rpx solid var(--line); border-radius: 17rpx; background: #fff; }.order-card-head { display: flex; justify-content: space-between; gap: 14rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }.order-number { font-size: 27rpx; font-weight: 750; }.order-date { margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }.order-status { flex: none; color: var(--brand); font-size: 24rpx; font-weight: 700; }.order-item { display: flex; justify-content: space-between; gap: 20rpx; padding-top: 15rpx; color: #45635a; font-size: 25rpx; }.order-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 23rpx; }.order-card-foot text { color: var(--accent); font-size: 31rpx; font-weight: 800; }.wechat-link { color: var(--brand); font-size: 24rpx; font-weight: 700; }
