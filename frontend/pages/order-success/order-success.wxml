<view class="success-page"><view class="language-toggle success-language" bindtap="toggleLanguage">{{t.language}}</view><view class="success-mark">OK</view><view class="success-title">{{t.orderSuccess}}</view><view class="success-order">{{t.orderNo}}: {{orderNo}}</view><view class="contact-card"><view class="contact-card-title">{{t.contactOwner}}</view><image wx:if="{{shop.wechatQrBase64}}" class="contact-qr" src="{{shop.wechatQrBase64}}" mode="aspectFit" bindtap="previewWechat"></image><view wx:else class="qr-empty">{{t.noWechat}}</view><button class="primary-btn" bindtap="previewWechat">{{t.addWechat}}</button></view><button class="orders-link" bindtap="toOrders">{{t.backOrders}}</button></view>
