.success-page { min-height: 100vh; box-sizing: border-box; padding: 92rpx 32rpx 60rpx; text-align: center; background: var(--bg); }.success-language { position: absolute; top: 30rpx; right: 30rpx; color: var(--brand); }.success-mark { width: 96rpx; height: 96rpx; margin: 26rpx auto 20rpx; border-radius: 50%; background: var(--brand); color: #fff; font-size: 25rpx; font-weight: 800; line-height: 96rpx; letter-spacing: 1rpx; }.success-title { color: var(--ink); font-size: 40rpx; font-weight: 780; }.success-order { margin-top: 14rpx; color: var(--muted); font-size: 24rpx; }.contact-card { margin-top: 48rpx; padding: 32rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(20, 72, 56, .08); }.contact-card-title { color: var(--ink); font-size: 30rpx; font-weight: 700; line-height: 1.55; }.contact-qr { width: 292rpx; height: 292rpx; margin: 28rpx auto; }.qr-empty { padding: 70rpx 10rpx; color: var(--muted); font-size: 25rpx; }.orders-link { margin-top: 26rpx; color: var(--brand); background: transparent; font-size: 28rpx; font-weight: 700; }
