<view class="address-page">
  <view class="address-header"><view><view class="address-title">{{t.addressBook}}</view><view class="address-subtitle">{{t.addressBookHint}}</view></view><view class="language-toggle address-language" bindtap="toggleLanguage">{{t.language}}</view></view>
  <view wx:if="{{addresses.length}}" class="address-list"><view wx:for="{{addresses}}" wx:key="id" class="address-record"><view class="address-record-head"><view class="address-name">{{item.recipientName}} <text>{{item.contactPhone}}</text></view><view wx:if="{{item.defaultAddress}}" class="default-tag">{{t.defaultAddress}}</view></view><view class="address-detail">{{item.shippingAddress}}</view><view class="address-actions"><view class="address-edit" data-address="{{item}}" bindtap="edit">{{t.edit}}</view><view class="address-delete" data-id="{{item.id}}" bindtap="remove">{{t.deleteAddress}}</view></view></view></view>
  <view wx:else class="empty address-empty">{{t.noAddresses}}</view>
  <view class="address-form"><view class="form-title">{{editingId ? t.editAddress : t.addAddress}}</view><input class="field" placeholder="{{t.recipientName}}" value="{{form.recipientName}}" data-key="recipientName" bindinput="field"/><input class="field" placeholder="{{t.contactPhone}}" type="number" value="{{form.contactPhone}}" data-key="contactPhone" bindinput="field"/><textarea class="field textarea" placeholder="{{t.shippingAddress}}" value="{{form.shippingAddress}}" data-key="shippingAddress" bindinput="field"/><view class="default-row" bindtap="toggleDefault"><view class="default-check {{form.defaultAddress ? 'checked' : ''}}">{{form.defaultAddress ? '✓' : ''}}</view><text>{{t.setDefaultAddress}}</text></view><view class="form-actions"><button wx:if="{{editingId}}" class="secondary-btn cancel-button" bindtap="cancel">{{t.cancel}}</button><button class="primary-btn form-save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{editingId ? t.update : t.addAddress}}</button></view></view>
</view>
