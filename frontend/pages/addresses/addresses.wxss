.address-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 24rpx 52rpx; background: var(--bg); }.address-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 26rpx; }.address-title { color: var(--ink); font-size: 40rpx; font-weight: 750; }.address-subtitle { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }.address-language { color: var(--brand); }.address-list { margin-bottom: 24rpx; }.address-record { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fff; }.address-record-head,.address-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.address-name { color: var(--ink); font-size: 29rpx; font-weight: 750; }.address-name text { margin-left: 12rpx; color: var(--muted); font-size: 24rpx; font-weight: 400; }.default-tag { padding: 4rpx 10rpx; border-radius: 8rpx; color: var(--brand); background: var(--brand-soft); font-size: 20rpx; }.address-detail { margin-top: 12rpx; color: #466259; font-size: 25rpx; line-height: 1.5; }.address-actions { justify-content: flex-end; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); font-size: 23rpx; }.address-edit { color: var(--brand); }.address-delete { color: var(--danger); }.address-empty { margin-bottom: 22rpx; }.address-form { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; }.form-title { margin-bottom: 18rpx; color: var(--ink); font-size: 30rpx; font-weight: 750; }.field { width: 100%; height: 82rpx; margin-bottom: 16rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #d6e1db; border-radius: 12rpx; background: #fbfcfb; color: var(--ink); font-size: 27rpx; line-height: 80rpx; }.textarea { height: 140rpx; padding-top: 17rpx; line-height: 1.45; }.default-row { display: flex; align-items: center; gap: 12rpx; margin: 2rpx 0 22rpx; color: var(--ink); font-size: 25rpx; }.default-check { width: 34rpx; height: 34rpx; box-sizing: border-box; border: 2rpx solid #a8c2b8; border-radius: 8rpx; color: #fff; background: #fff; font-size: 25rpx; line-height: 30rpx; text-align: center; }.default-check.checked { border-color: var(--brand); background: var(--brand); }.form-actions { display: flex; gap: 16rpx; }.form-save { flex: 1; margin: 0; }.cancel-button { min-width: 148rpx; margin: 0; }
